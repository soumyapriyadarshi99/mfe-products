{
  "include": ["src"],
  "compilerOptions": {
    "target": "ES2020",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"]
  }
}
